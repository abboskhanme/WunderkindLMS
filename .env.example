# Bu fayldan `.env` nusxa oling va qiymatlarni to'ldiring (`.env` ni git'ga QO'SHMANG).

# Sizning asosiy domeningiz (subdomensiz). Maktablar shuning subdomeni bo'ladi.
ROOT_DOMAIN=maktab.uz

# ── BAZA ROLLARI (SPEC §4.1) ── Uchta alohida parol, uchta alohida rol.
# Sababi: PostgreSQL'da jadval EGASIGA `REVOKE` ta'sir qilmaydi. Ilova ega rol bilan
# ulansa, "kassir to'lovni o'chira olmaydi" himoyasi umuman ishlamaydi.
# Har birini alohida yarating:  openssl rand -base64 32

# 1) Bootstrap superuser (`schoollms`) — POSTGRES_USER. pg_isready, pg_dump va
#    favqulodda kirish uchun. ILOVA BU ROL BILAN ULANMAYDI.
DB_PASSWORD=

# 2) `app_rw` — ilova shu rol bilan ishlaydi (ConnectionStrings__Default).
#    Hech narsaga EGA EMAS. Oddiy jadvallarda to'liq CRUD, moliyaviy jadvallarda
#    faqat SELECT/INSERT (UPDATE/DELETE olib tashlangan).
DB_APP_PASSWORD=

# 3) `schoollms_owner` — sxema egasi, FAQAT migratsiya (ConnectionStrings__Migrator).
DB_MIGRATOR_PASSWORD=

# JWT imzo kaliti — kamida 32 belgi tasodifiy satr. Masalan:
#   openssl rand -base64 48
JWT_KEY=REPLACE_WITH_RANDOM_48_CHARS_MINIMUM_xxxxxxxxxxxxxx

# Cloudflare Tunnel tokeni — Zero Trust → Networks → Tunnels → (tunnel) → token.
TUNNEL_TOKEN=eyJ...your-tunnel-token...
