<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- Application qatlami SignalR (chat hub), Hosting (fon xizmatlari),
       DI, MemoryCache va HttpClient'dan foydalanadi — bular ASP.NET Core
       umumiy freymvorkida. EF Core esa alohida paket. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <!-- Web SDK implicit ravishda import qiladigan, lekin class library SDK qilmaydigan
       namespace'lar (kod shularsiz ishlab kelgan). -->
  <ItemGroup>
    <Using Include="Microsoft.AspNetCore.Http" />
    <Using Include="Microsoft.AspNetCore.Hosting" />
    <Using Include="Microsoft.Extensions.Configuration" />
    <Using Include="Microsoft.Extensions.DependencyInjection" />
    <Using Include="Microsoft.Extensions.Hosting" />
    <Using Include="Microsoft.Extensions.Logging" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.*" />
    <!-- Relational: FAQAT `Database.ExecuteSqlRawAsync` uchun (P1-10, CashShiftService).
         Chek raqamining uzluksizligi `pg_advisory_xact_lock` ga tayanadi, uni esa LINQ
         bilan ifodalab bo'lmaydi. Yangi bog'liqlik EMAS: bu assembly Npgsql provayderi
         bilan birga allaqachon runtime'da bor edi, shu paytgacha shunchaki kompilyatsiya
         vaqtida ko'rinmasdi. Provayderga (Npgsql) bog'liqlik AVVALGIDEK YO'Q. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.*" />
    <!-- To'lov cheki PDF'i (P1-12, Billing/ReceiptDocument.cs).
         LITSENZIYA: QuestPDF Community — yillik yalpi tushumi 1 000 000 USD dan kam
         tashkilotlar uchun BEPUL; maktab shu toifada (paket ichidagi LICENSE.md,
         "License Selection Guide" -> "Small businesses", 2026-09-11 da tekshirilgan).
         Pul sarflanmaydi. Batafsil: docs/ASSUMPTIONS.md.
         Versiya QAT'IY (10.* emas): PDF chiqishi mijozga ketadigan hujjat, uni
         e'tiborsiz minor yangilanish o'zgartirib yuborishi mumkin emas.
         Litsenziya turi kodda: ReceiptDocument statik konstruktorida. -->
    <PackageReference Include="QuestPDF" Version="2026.8.0" />
    <!-- Chekdagi QR kod (mijoz, 2026-09-24). QRCoder — MIT litsenziya, bepul, sof managed kod
         (System.Drawing'ga bog'liq emas: PngByteQRCode). -->
    <PackageReference Include="QRCoder" Version="1.6.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SchoolLms.Domain\SchoolLms.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Chekdagi maktab logosi (mijoz bergan fayl, 2026-09-24) — PDF chizmasi uchun. -->
    <EmbeddedResource Include="Billing/Assets/receipt-logo.jpg" LogicalName="SchoolLms.ReceiptLogo.jpg" />
  </ItemGroup>
</Project>
